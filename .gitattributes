*.md text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.mk text eol=lf
*.hex -text
*.bin -text
*.elf -text
*.pdf -text
# Preserve the exact bytes used by BSP/release SHA-256 verification.
TouchRGB/firmware/bsps/** -text
TouchRGB/firmware/*.c -text
TouchRGB/firmware/*.h -text
TouchRGB/firmware/Makefile -text
TouchRGB/firmware/vendor/** -text
TouchRGB/sdk/** -text
TouchRGB/prebuilt/** -text
TouchRGB/prebuilt/README.md text eol=lf
# CapSlide board snapshots and prebuilt checksums require exact bytes.
CapSlide/firmware/bsps/** -text
CapSlide/firmware/FreeRTOSConfig.h -text
CapSlide/firmware/vendor/** -text
CapSlide/sdk/** -text
CapSlide/prebuilt/** -text
CapSlide/prebuilt/README.md text eol=lf
# FalseTouch-Shield preserves generated/vendor bytes and recorded artifacts.
FalseTouch-Shield/firmware/bsps/** -text
FalseTouch-Shield/firmware/FreeRTOSConfig.h -text
FalseTouch-Shield/firmware/vendor/** -text
FalseTouch-Shield/sdk/** -text
FalseTouch-Shield/prebuilt/** -text
FalseTouch-Shield/prebuilt/README.md text eol=lf
FalseTouch-Shield/prebuilt/FalseTouch-Shield-Windows-x64.zip filter=lfs diff=lfs merge=lfs -text

# ChordSlide snapshots and recorded evidence retain exact verified bytes.
ChordSlide/** -text
