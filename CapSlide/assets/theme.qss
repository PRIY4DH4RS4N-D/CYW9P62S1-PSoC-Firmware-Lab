QWidget { color: #dbeafa; font-family: 'Segoe UI'; font-size: 13px; }
QWidget#root { background: #070e1d; }
QFrame#header, QFrame#taskbar { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #13263b,stop:1 #0b1729); border: 1px solid #1d344e; border-radius: 12px; }
QFrame#monitor { background: #0d192a; border: 1px solid #20364e; border-radius: 14px; }
QLabel#brand { color: #65e6ff; font-size: 24px; font-weight: 700; letter-spacing: 4px; }
QLabel#muted { color: #7c96b4; font-size: 12px; }
QLabel#section { color: #62dff7; font-weight: 600; letter-spacing: 2px; }
QPushButton { background: #14273d; border: 1px solid #29435e; border-radius: 7px; padding: 8px 10px; }
QPushButton:hover, QPushButton[touchHover="true"] { background: #203e58; border-color: #4acbea; }
QPushButton:pressed, QPushButton:checked { background: #14536c; border-color: #5ce5ff; }
QPushButton#desktopIcon { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #152d44,stop:1 #0e1e32); text-align: left; font-size: 13px; padding: 12px 8px; border-radius: 12px; }
QFrame#deskWindow { background: #102036; border: 1px solid #3a6b8a; border-radius: 10px; }
QFrame#titleBar { background: #19324b; border-top-left-radius: 10px; border-top-right-radius: 10px; }
QLineEdit, QTextEdit, QListWidget { background: #091626; border: 1px solid #28445f; border-radius: 6px; padding: 8px; selection-background-color: #17617e; }
QLineEdit#calcDisplay { font-size: 28px; padding: 15px; }
QListWidget::item { padding: 12px; }
QListWidget::item:selected { background: #17516b; }
QSlider::groove:horizontal { height: 5px; background: #25415a; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; margin: -6px 0; border-radius: 8px; background: #60dcfa; }
QProgressBar { border: 0; background: #1b3047; border-radius: 4px; text-align: center; height: 9px; }
QProgressBar::chunk { background: #46c8ea; border-radius: 4px; }
QFrame#context { background: #142b43; border: 1px solid #5bd7f4; border-radius: 8px; }
QScrollArea { background: transparent; border: none; }
QWidget#settingsContent, QWidget#settingsViewport { background: #102036; }
QScrollBar:vertical { background: #0b192a; width: 8px; border-radius: 4px; }
QScrollBar::handle:vertical { background: #294b65; min-height: 25px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QLabel#taskClock { font-family: 'Consolas'; font-size: 15px; color: #a9d7ef; padding: 6px; }
